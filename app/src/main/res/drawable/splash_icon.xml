<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">

    <!-- Dark Circular Watch Dial -->
    <path
        android:pathData="M48,8 A40,40 0 1,0 48,88 A40,40 0 1,0 48,8"
        android:strokeWidth="1.5"
        android:strokeColor="#26354D">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="48"
                android:centerY="44"
                android:gradientRadius="44">
                <item android:offset="0.0" android:color="#FF162035" />
                <item android:offset="0.7" android:color="#FF0C101A" />
                <item android:offset="1.0" android:color="#FF05070B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gauge Arcs -->
    <!-- CPU Arc (Cyan) -->
    <path
        android:pathData="M24,58 A30,30 0 0,1 44,20"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />
    <!-- Battery Arc (Green) -->
    <path
        android:pathData="M52,20 A30,30 0 0,1 74,54"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeColor="#00E676" />
    <!-- Temp Arc (Orange) -->
    <path
        android:pathData="M68,66 A30,30 0 0,1 42,76"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeColor="#FF9100" />

    <!-- Chip Pins -->
    <path
        android:pathData="M43,33 h2.5 v3.5 h-2.5 z M50.5,33 h2.5 v3.5 h-2.5 z"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M43,59.5 h2.5 v3.5 h-2.5 z M50.5,59.5 h2.5 v3.5 h-2.5 z"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M33,43 h3.5 v2.5 h-3.5 z M33,50.5 h3.5 v2.5 h-3.5 z"
        android:fillColor="#00E5FF" />
    <path
        android:pathData="M59.5,43 h3.5 v2.5 h-3.5 z M59.5,50.5 h3.5 v2.5 h-3.5 z"
        android:fillColor="#00E5FF" />

    <!-- Chip Body -->
    <path
        android:pathData="M41,36 h14 c2.8,0 5,2.2 5,5 v14 c0,2.8 -2.2,5 -5,5 h-14 c-2.8,0 -5,-2.2 -5,-5 v-14 c0,-2.8 2.2,-5 5,-5 z"
        android:strokeWidth="1.2"
        android:strokeColor="#8000E5FF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="36"
                android:endX="60"
                android:endY="60">
                <item android:offset="0.0" android:color="#FF1E293D" />
                <item android:offset="1.0" android:color="#FF0E1422" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pulse Waveform -->
    <path
        android:pathData="M38,48 L42,48 L43.5,50.5 L45.5,42 L48,53 L50.5,45.5 L52.5,48 L58,48"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#4D00E5FF" />
    <path
        android:pathData="M38,48 L42,48 L43.5,50.5 L45.5,42 L48,53 L50.5,45.5 L52.5,48 L58,48"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FFFFFFFF" />
</vector>
