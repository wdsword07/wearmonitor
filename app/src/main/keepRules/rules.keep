# Project specific R8 / ProGuard rules

# 保留 androidx.startup 与生命周期初始化器
-keep class androidx.startup.** { *; }
-keep class androidx.lifecycle.ProcessLifecycleInitializer { *; }

# 保留 ViewModel 构造函数
-keepclassmembers class * extends androidx.lifecycle.ViewModel {
    <init>(...);
}
-keepclassmembers class * extends androidx.lifecycle.AndroidViewModel {
    <init>(android.app.Application);
}

# 保留应用内的组件、TileService 及数据模型
-keep class com.github.wdsword07.wearmonitor.data.model.** { *; }
-keep class com.github.wdsword07.wearmonitor.tile.** { *; }
-keep class com.github.wdsword07.wearmonitor.presentation.** { *; }
